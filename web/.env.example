# The bundled deployment is NEAR testnet. Leave contract/profile overrides empty
# to use it. A custom deployment must provide all contract/profile values.
VITE_NETWORK_ID=testnet
VITE_CORE_ACCOUNT_ID=
VITE_TOKEN_ACCOUNT_ID=
VITE_RPC_URL=https://test.rpc.fastnear.com
VITE_CRYPTO_PROFILE_HASH=
# SHA-256 pin of the complete crypto manifest (not a proof/profile hash).
VITE_CRYPTO_ARTIFACT_HASH=
VITE_CRYPTO_MANIFEST_URL=/crypto/manifest.json
VITE_CRYPTO_ARTIFACT_BASE_URL=
VITE_FUNDED_DEPLOYMENT=false
VITE_ASSET_DECIMALS=
VITE_ASSET_SYMBOL=TEST

# Optional: show Email or social login alongside NEAR Connect ecosystem wallets.
# Both values are public frontend identifiers, never an app secret.
# NEAR Connect also lists native NEAR wallets without Privy configuration.
VITE_PRIVY_APP_ID=
VITE_PRIVY_APP_CLIENT_ID=

# Only enable for a custom TEST deployment that implements the test-token faucet.
# The bundled testnet deployment enables this automatically.
VITE_TESTNET_FAUCET=
