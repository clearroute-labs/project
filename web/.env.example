# Deployment values are intentionally empty by default. The UI renders a clear
# disconnected state until a real wallet and client adapter are supplied.
VITE_NETWORK_ID=testnet
VITE_CORE_ACCOUNT_ID=
VITE_TOKEN_ACCOUNT_ID=
VITE_RPC_URL=https://rpc.testnet.near.org
# Set only for a local HTTP sandbox RPC; production RPC must use HTTPS.
VITE_ALLOW_INSECURE_LOCALHOST=false
VITE_CRYPTO_PROFILE_HASH=
VITE_CRYPTO_ARTIFACT_HASH=
VITE_ASSET_DECIMALS=
VITE_ASSET_SYMBOL=ASSET
